// 繁體中文對話框，由 foo_discord_listening.rc 依語言引入（台灣、香港、澳門）。

IDD_PREFS DIALOGEX 0, 0, 332, 276
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "在 Discord 顯示正在播放的歌曲", IDC_ENABLED, 7, 3, 318, 10

    GROUPBOX        "狀態", IDC_STATIC, 7, 16, 318, 74
    LTEXT           "類型：", IDC_STATIC, 15, 30, 70, 8
    COMBOBOX        IDC_ACTIVITY_TYPE, 90, 28, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "顯示進度條", IDC_SHOW_TIME, 218, 30, 104, 10
    LTEXT           "狀態列顯示：", IDC_STATIC, 15, 45, 70, 8
    COMBOBOX        IDC_STATUS_DISPLAY, 90, 43, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "暫停時：", IDC_STATIC, 15, 60, 70, 8
    COMBOBOX        IDC_PAUSE_MODE, 90, 58, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "停止時：", IDC_STATIC, 15, 75, 70, 8
    COMBOBOX        IDC_STOP_MODE, 90, 73, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "文字（title formatting）", IDC_STATIC, 7, 94, 318, 59
    LTEXT           "第一行：", IDC_STATIC, 15, 108, 70, 8
    EDITTEXT        IDC_DETAILS_FORMAT, 90, 106, 228, 12, ES_AUTOHSCROLL
    LTEXT           "第二行：", IDC_STATIC, 15, 123, 70, 8
    EDITTEXT        IDC_STATE_FORMAT, 90, 121, 228, 12, ES_AUTOHSCROLL
    LTEXT           "第三行／封面提示：", IDC_STATIC, 15, 138, 74, 8
    EDITTEXT        IDC_LARGE_TEXT_FORMAT, 90, 136, 228, 12, ES_AUTOHSCROLL

    GROUPBOX        "圖示", IDC_STATIC, 7, 157, 318, 58
    AUTOCHECKBOX    "在封面角落顯示播放／暫停／停止圖示", IDC_SMALL_ICONS, 15, 169, 300, 10
    AUTOCHECKBOX    "曲目沒有封面時顯示預設圖", IDC_NO_ART_IMAGE, 15, 184, 300, 10
    AUTOCHECKBOX    "在第一行加上（已暫停）／（已停止）", IDC_PAUSED_TEXT, 15, 199, 300, 10

    GROUPBOX        "Discord", IDC_STATIC, 7, 219, 318, 40
    LTEXT           "應用程式 ID：", IDC_STATIC, 15, 232, 70, 8
    EDITTEXT        IDC_APP_ID, 90, 230, 120, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "（留空＝使用內建）", IDC_STATIC, 215, 232, 105, 8
    LTEXT           "連線狀態：", IDC_STATIC, 15, 246, 70, 8
    LTEXT           "", IDC_STATUS, 90, 246, 228, 8
END

IDD_PREFS_ART DIALOGEX 0, 0, 332, 276
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "顯示專輯封面", IDC_ART_ENABLED, 7, 3, 318, 10

    GROUPBOX        "封面來源（依序嘗試）", IDC_STATIC, 7, 16, 318, 106
    AUTOCHECKBOX    "MusicBrainz", IDC_USE_MUSICBRAINZ, 15, 30, 80, 10
    LTEXT           "伺服器：", IDC_STATIC, 100, 31, 40, 8
    EDITTEXT        IDC_MUSICBRAINZ_SERVER, 145, 28, 173, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "iTunes", IDC_USE_ITUNES, 15, 46, 80, 10
    LTEXT           "商店國家：", IDC_STATIC, 100, 47, 50, 8
    EDITTEXT        IDC_ITUNES_COUNTRY, 155, 44, 30, 12, ES_AUTOHSCROLL | ES_UPPERCASE
    AUTOCHECKBOX    "Last.fm", IDC_USE_LASTFM, 15, 62, 80, 10
    LTEXT           "API key：", IDC_STATIC, 100, 63, 40, 8
    EDITTEXT        IDC_LASTFM_KEY, 145, 60, 173, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "上傳本機封面", IDC_USE_UPLOAD, 15, 78, 80, 10
    LTEXT           "指令：", IDC_STATIC, 100, 79, 40, 8
    EDITTEXT        IDC_UPLOAD_COMMAND, 145, 76, 173, 12, ES_AUTOHSCROLL
    LTEXT           "手動指定的封面（右鍵 > Utilities > 指定 Discord 專輯封面）一律最優先。伺服器留空＝musicbrainz.org。", IDC_STATIC, 15, 94, 303, 20

    GROUPBOX        "比對", IDC_STATIC, 7, 126, 318, 50
    LTEXT           "視為同一張專輯：", IDC_STATIC, 15, 140, 75, 8
    EDITTEXT        IDC_UPLOAD_KEY, 90, 138, 228, 12, ES_AUTOHSCROLL
    LTEXT           "不抓封面的曲目：", IDC_STATIC, 15, 156, 75, 8
    EDITTEXT        IDC_ART_FILTER, 90, 154, 228, 12, ES_AUTOHSCROLL

    GROUPBOX        "快取", IDC_STATIC, 7, 180, 318, 34
    PUSHBUTTON      "清除封面快取", IDC_CLEAR_CACHE, 15, 193, 70, 14
    LTEXT           "", IDC_CACHE_INFO, 90, 196, 228, 8
END

IDD_PREFS_LINKS DIALOGEX 0, 0, 332, 276
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "所有欄位都使用 title formatting，留空即關閉。連結中的空白與中日文會自動編碼。", IDC_STATIC, 7, 3, 318, 18

    GROUPBOX        "連結（別人點擊文字或封面時開啟）", IDC_STATIC, 7, 24, 318, 59
    LTEXT           "第一行連結：", IDC_STATIC, 15, 38, 70, 8
    EDITTEXT        IDC_DETAILS_URL, 90, 36, 228, 12, ES_AUTOHSCROLL
    LTEXT           "第二行連結：", IDC_STATIC, 15, 53, 70, 8
    EDITTEXT        IDC_STATE_URL, 90, 51, 228, 12, ES_AUTOHSCROLL
    LTEXT           "封面連結：", IDC_STATIC, 15, 68, 70, 8
    EDITTEXT        IDC_LARGE_URL, 90, 66, 228, 12, ES_AUTOHSCROLL

    GROUPBOX        "按鈕（顯示給別人看，最多 2 個）", IDC_STATIC, 7, 87, 318, 74
    LTEXT           "按鈕 1 文字：", IDC_STATIC, 15, 101, 70, 8
    EDITTEXT        IDC_BUTTON1_LABEL, 90, 99, 228, 12, ES_AUTOHSCROLL
    LTEXT           "按鈕 1 連結：", IDC_STATIC, 15, 116, 70, 8
    EDITTEXT        IDC_BUTTON1_URL, 90, 114, 228, 12, ES_AUTOHSCROLL
    LTEXT           "按鈕 2 文字：", IDC_STATIC, 15, 131, 70, 8
    EDITTEXT        IDC_BUTTON2_LABEL, 90, 129, 228, 12, ES_AUTOHSCROLL
    LTEXT           "按鈕 2 連結：", IDC_STATIC, 15, 146, 70, 8
    EDITTEXT        IDC_BUTTON2_URL, 90, 144, 228, 12, ES_AUTOHSCROLL

    GROUPBOX        "隱私", IDC_STATIC, 7, 165, 318, 46
    LTEXT           "不顯示的曲目：", IDC_STATIC, 15, 179, 70, 8
    EDITTEXT        IDC_FILTER, 90, 177, 228, 12, ES_AUTOHSCROLL
    LTEXT           "foobar2000 搜尋語法，例如  %genre% HAS podcast  OR  %path% HAS private", IDC_STATIC, 90, 193, 228, 16

    LTEXT           "按鈕範例：文字  在 YouTube 搜尋   連結  https://www.youtube.com/results?search_query=[%artist% ]%title%", IDC_STATIC, 7, 217, 318, 18
END

IDD_MANUAL_ART DIALOGEX 0, 0, 300, 82
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "指定 Discord 專輯封面"
FONT 9, "Microsoft JhengHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_MANUAL_ALBUM, 7, 7, 286, 8
    LTEXT           "圖片網址（https://...）。留空則改回自動抓取的封面。", IDC_STATIC, 7, 21, 286, 8
    EDITTEXT        IDC_MANUAL_URL, 7, 33, 286, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "確定", IDOK, 189, 58, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 243, 58, 50, 14
END
