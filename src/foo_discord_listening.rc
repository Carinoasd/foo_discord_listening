#pragma code_page(65001)

#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#include "dialogs_en.rc"

// 繁體中文：Windows 會依介面語言自動選用。香港、澳門也使用同一份。
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL
#include "dialogs_zh_tw.rc"
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_HONGKONG
#include "dialogs_zh_tw.rc"
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_MACAU
#include "dialogs_zh_tw.rc"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FDL_VERSION_MAJOR,FDL_VERSION_MINOR,FDL_VERSION_PATCH,0
 PRODUCTVERSION FDL_VERSION_MAJOR,FDL_VERSION_MINOR,FDL_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Carinoasd"
            VALUE "FileDescription", "Discord Listening for foobar2000"
            VALUE "FileVersion", FDL_VERSION
            VALUE "InternalName", "foo_discord_listening"
            VALUE "LegalCopyright", "(C) 2026 Carinoasd"
            VALUE "OriginalFilename", "foo_discord_listening.dll"
            VALUE "ProductName", "foo_discord_listening"
            VALUE "ProductVersion", FDL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
