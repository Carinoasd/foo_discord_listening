#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_PREFS DIALOGEX 0, 0, 332, 288
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Show what I'm playing on Discord", IDC_ENABLED, 7, 7, 318, 10
    LTEXT           "Discord application ID (leave empty to use the built-in one):", IDC_STATIC, 7, 26, 318, 8
    EDITTEXT        IDC_APP_ID, 7, 37, 160, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Status:", IDC_STATIC, 7, 60, 30, 8
    LTEXT           "", IDC_STATUS, 40, 60, 285, 8
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FDL_VERSION_MAJOR,FDL_VERSION_MINOR,FDL_VERSION_PATCH,0
 PRODUCTVERSION FDL_VERSION_MAJOR,FDL_VERSION_MINOR,FDL_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Carinoasd"
            VALUE "FileDescription", "Discord Listening for foobar2000"
            VALUE "FileVersion", FDL_VERSION
            VALUE "InternalName", "foo_discord_listening"
            VALUE "LegalCopyright", "(C) 2026 Carinoasd"
            VALUE "OriginalFilename", "foo_discord_listening.dll"
            VALUE "ProductName", "foo_discord_listening"
            VALUE "ProductVersion", FDL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
