#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_PREFS DIALOGEX 0, 0, 332, 276
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Show what I'm playing on Discord", IDC_ENABLED, 7, 3, 318, 10

    GROUPBOX        "Activity", IDC_STATIC, 7, 16, 318, 59
    LTEXT           "Type:", IDC_STATIC, 15, 30, 70, 8
    COMBOBOX        IDC_ACTIVITY_TYPE, 90, 28, 110, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Show progress bar", IDC_SHOW_TIME, 210, 30, 110, 10
    LTEXT           "Status shows:", IDC_STATIC, 15, 45, 70, 8
    COMBOBOX        IDC_STATUS_DISPLAY, 90, 43, 110, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "When paused:", IDC_STATIC, 15, 60, 70, 8
    COMBOBOX        IDC_PAUSE_MODE, 90, 58, 110, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Text (title formatting)", IDC_STATIC, 7, 79, 318, 59
    LTEXT           "Line 1:", IDC_STATIC, 15, 93, 70, 8
    EDITTEXT        IDC_DETAILS_FORMAT, 90, 91, 228, 12, ES_AUTOHSCROLL
    LTEXT           "Line 2:", IDC_STATIC, 15, 108, 70, 8
    EDITTEXT        IDC_STATE_FORMAT, 90, 106, 228, 12, ES_AUTOHSCROLL
    LTEXT           "Line 3 / art tooltip:", IDC_STATIC, 15, 123, 72, 8
    EDITTEXT        IDC_LARGE_TEXT_FORMAT, 90, 121, 228, 12, ES_AUTOHSCROLL

    GROUPBOX        "Album art", IDC_STATIC, 7, 142, 318, 88
    AUTOCHECKBOX    "Show album art", IDC_ART_ENABLED, 15, 154, 120, 10
    LTEXT           "Source:", IDC_STATIC, 15, 169, 70, 8
    COMBOBOX        IDC_ART_SOURCE, 90, 167, 160, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Upload command:", IDC_STATIC, 15, 184, 70, 8
    EDITTEXT        IDC_UPLOAD_COMMAND, 90, 182, 228, 12, ES_AUTOHSCROLL
    LTEXT           "Upload once per:", IDC_STATIC, 15, 199, 70, 8
    EDITTEXT        IDC_UPLOAD_KEY, 90, 197, 228, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Clear art cache", IDC_CLEAR_CACHE, 15, 212, 70, 14
    LTEXT           "", IDC_CACHE_INFO, 90, 215, 228, 8

    GROUPBOX        "Discord", IDC_STATIC, 7, 234, 318, 40
    LTEXT           "Application ID:", IDC_STATIC, 15, 247, 70, 8
    EDITTEXT        IDC_APP_ID, 90, 245, 110, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "(empty = built-in)", IDC_STATIC, 205, 247, 110, 8
    LTEXT           "Status:", IDC_STATIC, 15, 261, 70, 8
    LTEXT           "", IDC_STATUS, 90, 261, 228, 8
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FDL_VERSION_MAJOR,FDL_VERSION_MINOR,FDL_VERSION_PATCH,0
 PRODUCTVERSION FDL_VERSION_MAJOR,FDL_VERSION_MINOR,FDL_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Carinoasd"
            VALUE "FileDescription", "Discord Listening for foobar2000"
            VALUE "FileVersion", FDL_VERSION
            VALUE "InternalName", "foo_discord_listening"
            VALUE "LegalCopyright", "(C) 2026 Carinoasd"
            VALUE "OriginalFilename", "foo_discord_listening.dll"
            VALUE "ProductName", "foo_discord_listening"
            VALUE "ProductVersion", FDL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
